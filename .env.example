# =============================================================================
# Sohona — environment template (safe to commit)
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# --- Phase 2 (required now) ---
# Public base URL of this app (no trailing slash)
APP_URL=http://localhost:3000

# --- Phase 3: Database (MongoDB Atlas) ---
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sohona?retryWrites=true&w=majority
DATABASE_URL=

# --- Day 2: Admin auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed as temple admins
ADMIN_EMAIL_ALLOWLIST=

# --- Day 4: Cloudflare R2 (private bucket only) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- Day 8: Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
