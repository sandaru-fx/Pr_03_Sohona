# =============================================================================
# Sohona — environment template (safe to commit)
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# --- Phase 2 (required now) ---
# Public base URL of this app (no trailing slash)
# Local:  http://localhost:3000
# Vercel: https://YOUR_PROJECT.vercel.app  (or custom domain)
APP_URL=http://localhost:3000

# --- Phase 3: Database (MongoDB Atlas) ---
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sohona?retryWrites=true&w=majority
# Atlas Network Access: allow your IP locally; for Vercel allow 0.0.0.0/0 (or Atlas VPC later)
DATABASE_URL=

# --- Day 2: Admin auth (Auth.js / NextAuth) ---
# Phase 2.1 (required): Generate with: openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Prefer a NEW AUTH_SECRET for production (do not reuse a leaked local value).
AUTH_SECRET=
# Phase 2.2: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Local:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
# Production (add BOTH local + prod if you keep one client):
#   Origins:  https://YOUR_PROJECT.vercel.app
#   Redirect: https://YOUR_PROJECT.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Phase 2.3: Comma-separated Google emails allowed as temple admins (required for login)
# Example: you@gmail.com,other.admin@temple.org
ADMIN_EMAIL_ALLOWLIST=

# --- Day 4: Cloudflare R2 (private bucket only — never public) ---
# Cloudflare Dashboard → R2 → Create bucket (keep public access OFF)
# Create API token / R2 S3 credentials, then set:
# R2_ENDPOINT example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional for text-only demo; required for photo/video/voice upload + playback.
# If browser PUT uploads fail from the live domain, add R2 CORS for that origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- Day 8: Rate limiting (Upstash Redis) ---
# Optional. Missing → APIs degrade open; DB PIN/setup locks still apply.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Day 10 — Vercel checklist (set these in Project → Settings → Environment Variables)
# =============================================================================
# Local readiness (never prints secrets):
#   npm run day10:env-check
#
# 1) Create Vercel project from GitHub: sandaru-fx/Pr_03_Sohona (master)
# 2) Framework preset: Next.js (default). Build command uses package.json "build".
# 3) Set at least: APP_URL, DATABASE_URL, AUTH_SECRET, AUTH_GOOGLE_*, ADMIN_EMAIL_ALLOWLIST
#    Production APP_URL must be https://YOUR_PROJECT.vercel.app (not localhost)
# 4) Redeploy after adding Google OAuth production redirect URIs
# 5) Optional: R2_* and UPSTASH_REDIS_* for full media + distributed rate limits
# 6) Never commit .env — only this .env.example
#
# Day 10.3 — external wiring (exact OAuth URIs + CORS JSON):
#   npm run day10:wiring-check
# Google: add APP_URL origin + APP_URL/api/auth/callback/google
# Atlas: allow 0.0.0.0/0 for Vercel (or tighten later)
# R2: private bucket + CORS for Production APP_URL (script prints JSON)
# Redis: optional Upstash REST URL/token
